---
import { FEATURED_INSTAGRAM_POSTS, publicInstagramPosts, validSocialLinks } from '../data/socialLinks';

interface Props {
	language: 'en' | 'ja';
}

const { language } = Astro.props;
const profile = validSocialLinks().find((link) => link.platform === 'instagram');
const posts = publicInstagramPosts(FEATURED_INSTAGRAM_POSTS);
const copy = language === 'ja'
	? {
		eyebrow: 'FROM THE STUDIO',
		title: 'Instagram',
		intro: 'Petalwake Studiosで形になっていく物語、作品、制作の断片をお届けします。',
		follow: 'Instagramをフォロー',
		view: 'Instagramの投稿を見る',
		load: 'Instagramの投稿を表示',
		loading: '投稿を読み込み中…',
		failed: 'Instagramの投稿をここに表示できませんでした。',
		openProfile: 'Instagramで見る',
		profileLabel: 'Petalwake StudiosのInstagramアカウント',
	}
	: {
		eyebrow: 'FROM THE STUDIO',
		title: 'Instagram',
		intro: 'Release artwork, visual experiments, and glimpses behind the stories taking shape at Petalwake Studios.',
		follow: 'Follow on Instagram',
		view: 'View Instagram post',
		load: 'Load Instagram post',
		loading: 'Loading the post…',
		failed: 'This Instagram post could not be displayed here.',
		openProfile: 'View on Instagram',
		profileLabel: 'Petalwake Studios Instagram profile',
	};
const handle = profile ? new URL(profile.url).pathname.split('/').filter(Boolean)[0] : '';
---

<section class="instagram-studio section-wrap" aria-labelledby="instagram-studio-title" data-reveal lang={language}>
	<div class="instagram-studio__intro">
		<p class="eyebrow">{copy.eyebrow}</p>
		<h2 id="instagram-studio-title">{copy.title}</h2>
		<p>{copy.intro}</p>
		{profile && <a class="instagram-studio__follow" href={profile.url} target="_blank" rel="noopener noreferrer">{copy.follow} <span aria-hidden="true">↗</span></a>}
	</div>
	{posts.length > 0 ? (
		<div class="instagram-studio__posts" aria-label={language === 'ja' ? '注目のInstagram投稿' : 'Featured Instagram posts'}>
			{posts.map((post) => (
				<article class="instagram-post" data-instagram-post data-permalink={post.permalink}>
					<div class="instagram-post__preview" data-instagram-preview>
						<img src={post.previewImage} alt={post.previewAlt[language] ?? (language === 'ja' ? 'Petalwake StudiosのInstagram投稿プレビュー' : 'Preview of a Petalwake Studios Instagram post')} loading="lazy" decoding="async" />
					</div>
					<div class="instagram-post__embed" data-instagram-embed hidden>
					</div>
					<div class="instagram-post__actions">
						<button class="instagram-post__load" type="button" data-instagram-load data-loading-label={copy.loading}>{copy.load}</button>
						<a href={post.permalink} target="_blank" rel="noopener noreferrer">{copy.view} <span aria-hidden="true">↗</span></a>
					</div>
					<p class="instagram-post__status" role="status" aria-live="polite" data-instagram-status></p>
					<p class="instagram-post__fallback" data-instagram-fallback hidden>{copy.failed} <a href={post.permalink} target="_blank" rel="noopener noreferrer">{copy.openProfile}</a></p>
				</article>
			))}
		</div>
	) : (
		<div class="instagram-studio__profile">
			<div class="instagram-studio__glyph" aria-hidden="true">
				<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" /></svg>
			</div>
			<div>
				<p class="eyebrow">Petalwake Studios</p>
				<strong>{handle ? `@${handle}` : 'Instagram'}</strong>
			</div>
			{profile && <a class="instagram-studio__profile-link" href={profile.url} target="_blank" rel="noopener noreferrer" aria-label={copy.profileLabel}>{copy.openProfile} <span aria-hidden="true">↗</span></a>}
		</div>
	)}
</section>

{posts.length > 0 && (
	<script>
		declare global {
			interface Window {
				instgrm?: { Embeds: { process: () => void } };
				petalwakeInstagramEmbed?: Promise<void>;
			}
		}

		const ensureInstagramEmbedScript = () => {
			if (window.instgrm) return Promise.resolve();
			if (window.petalwakeInstagramEmbed) return window.petalwakeInstagramEmbed;
			window.petalwakeInstagramEmbed = new Promise((resolve, reject) => {
				const script = document.createElement('script');
				script.src = 'https://www.instagram.com/embed.js';
				script.async = true;
				script.onload = () => resolve();
				script.onerror = () => {
					window.petalwakeInstagramEmbed = undefined;
					reject(new Error('Instagram embed could not load'));
				};
				document.head.append(script);
			});
			return window.petalwakeInstagramEmbed;
		};

		document.querySelectorAll<HTMLElement>('[data-instagram-post]').forEach((card) => {
			const button = card.querySelector<HTMLButtonElement>('[data-instagram-load]');
			const preview = card.querySelector<HTMLElement>('[data-instagram-preview]');
			const embed = card.querySelector<HTMLElement>('[data-instagram-embed]');
			const status = card.querySelector<HTMLElement>('[data-instagram-status]');
			const fallback = card.querySelector<HTMLElement>('[data-instagram-fallback]');
			button?.addEventListener('click', async () => {
				if (!embed || !status || !fallback) return;
				button.disabled = true;
				status.textContent = button.dataset.loadingLabel ?? '';
				try {
					await ensureInstagramEmbedScript();
					if (!window.instgrm) throw new Error('Instagram embed is unavailable');
					const permalink = card.dataset.permalink;
					if (!permalink) throw new Error('Instagram permalink is unavailable');
					const blockquote = document.createElement('blockquote');
					blockquote.className = 'instagram-media';
					blockquote.dataset.instgrmPermalink = permalink;
					blockquote.dataset.instgrmVersion = '14';
					const postLink = document.createElement('a');
					postLink.href = permalink;
					postLink.target = '_blank';
					postLink.rel = 'noopener noreferrer';
					postLink.textContent = button.textContent ?? '';
					blockquote.append(postLink);
					embed.replaceChildren(blockquote);
					embed.hidden = false;
					window.instgrm.Embeds.process();
					await new Promise<void>((resolve, reject) => {
						const startedAt = Date.now();
						const waitForEmbed = () => {
							if (embed.querySelector('iframe')) { resolve(); return; }
						if (Date.now() - startedAt > 10000) { reject(new Error('Instagram post did not render')); return; }
						window.setTimeout(waitForEmbed, 250);
						};
						waitForEmbed();
					});
					if (preview) preview.hidden = true;
					status.textContent = '';
					button.hidden = true;
				} catch {
					embed.hidden = true;
					embed.replaceChildren();
					if (preview) preview.hidden = false;
					fallback.hidden = false;
					status.textContent = '';
					button.disabled = false;
				}
			});
		});
	</script>
)}
