---
import { SITE_TITLE, YOUTUBE_CHANNEL } from '../consts';
import { common } from '../i18n/common';
import { localeFromPath, localizedPath } from '../i18n/routing';

const locale = localeFromPath(Astro.url.pathname);
const labels = common[locale];
const homeHref = localizedPath('/', locale);
const workHref = localizedPath('/work/', locale);
const aboutHref = localizedPath('/about/', locale);
const gospelHref = localizedPath('/gospel/', locale);
const contactHref = localizedPath('/contact/', locale);
const englishHref = localizedPath(Astro.url.pathname, 'en');
const japaneseHref = localizedPath(Astro.url.pathname, 'ja');
---

<header class="site-header" data-japanese-href={japaneseHref}>
	<a class="site-header__wordmark" href={homeHref} aria-label={`${SITE_TITLE} ${labels.home}`}>
		<span>PETALWAKE<br />STUDIOS</span>
	</a>
	<nav class="language-switch" aria-label={labels.languageLabel}>
		<a
			href={englishHref}
			lang="en"
			aria-label={labels.englishName}
			aria-current={locale === 'en' ? 'page' : undefined}
			data-language-choice="en"
		>EN</a>
		<span aria-hidden="true">|</span>
		<a
			href={japaneseHref}
			lang="ja"
			aria-label={labels.japaneseName}
			aria-current={locale === 'ja' ? 'page' : undefined}
			data-language-choice="ja"
		>日本語</a>
	</nav>
	<details class="site-nav" open>
		<summary aria-label={labels.menu} aria-controls="site-navigation">
			<span class="site-nav__icon" aria-hidden="true"><span></span><span></span></span>
			<span class="site-nav__label">{labels.menu}</span>
			<span class="site-nav__label site-nav__label--close">{labels.closeMenu}</span>
		</summary>
		<nav id="site-navigation" aria-label={labels.navLabel}>
			<a href={homeHref} aria-current={Astro.url.pathname === homeHref ? 'page' : undefined}>{labels.home}</a>
			<a href={workHref} aria-current={Astro.url.pathname.startsWith(workHref) ? 'page' : undefined}>{labels.films}</a>
			<a href={aboutHref} aria-current={Astro.url.pathname === aboutHref ? 'page' : undefined}>{labels.about}</a>
			<a href={gospelHref} aria-current={Astro.url.pathname === gospelHref ? 'page' : undefined}>{labels.gospel}</a>
			<a href={contactHref} aria-current={Astro.url.pathname === contactHref ? 'page' : undefined}>{labels.contact}</a>
			<a class="site-header__cta" href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer">{labels.watchOnYouTube}</a>
			<div class="site-nav__appearance">
				<label for="site-appearance">{labels.appearance}</label>
				<select id="site-appearance" data-appearance-select>
					<option value="system">{labels.appearanceSystem}</option>
					<option value="light">{labels.appearanceLight}</option>
					<option value="dark">{labels.appearanceDark}</option>
				</select>
			</div>
		</nav>
	</details>
</header>

<script>
	type AppearanceChoice = 'system' | 'light' | 'dark';
	declare global {
		interface Window {
			petalwakeAppearance?: { setPreference: (preference: AppearanceChoice) => void };
		}
	}

	const appearanceSelect = document.querySelector<HTMLSelectElement>('[data-appearance-select]');
	const initialAppearance = document.documentElement.dataset.themeChoice;
	if (appearanceSelect) {
		appearanceSelect.value = initialAppearance === 'light' || initialAppearance === 'dark'
			? initialAppearance
			: 'system';
		appearanceSelect.addEventListener('change', () => {
			const preference = appearanceSelect.value as AppearanceChoice;
			try {
				localStorage.setItem('petalwake-appearance', preference);
			} catch (error) {
				console.warn('The appearance preference could not be saved in this browser.', error);
			}
			window.petalwakeAppearance?.setPreference(preference);
		});
	}

	try {
		const selectedLanguage = localStorage.getItem('petalwake-language');
		const japaneseDestination = document.querySelector<HTMLElement>('.site-header')?.dataset.japaneseHref;
		if (
			document.documentElement.lang === 'en' &&
			selectedLanguage === 'ja' &&
			japaneseDestination &&
			window.location.pathname !== japaneseDestination
		) {
			window.location.replace(japaneseDestination);
		}
	} catch (error) {
		console.warn('The saved language preference could not be read in this browser.', error);
	}

	document.querySelectorAll<HTMLAnchorElement>('[data-language-choice]').forEach((link) => {
		link.addEventListener('click', () => {
			try {
				localStorage.setItem('petalwake-language', link.dataset.languageChoice ?? 'en');
			} catch (error) {
				console.warn('The language preference could not be saved in this browser.', error);
			}
		});
	});

	const navigation = document.querySelector<HTMLDetailsElement>('.site-nav');
	const menuButton = navigation?.querySelector('summary');
	const mobileNavigation = window.matchMedia('(max-width: 1200px)');

	if (navigation) {
		navigation.open = !mobileNavigation.matches;

		mobileNavigation.addEventListener('change', ({ matches }) => {
			navigation.open = !matches;
			document.body.classList.remove('menu-open');
		});

		navigation.addEventListener('toggle', () => {
			document.body.classList.toggle('menu-open', navigation.open && mobileNavigation.matches);
		});

		navigation.addEventListener('click', (event) => {
			const target = event.target;
			if (target instanceof Element && target.closest('a') && mobileNavigation.matches) {
				navigation.open = false;
				document.body.classList.remove('menu-open');
			}
		});
	}

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && navigation?.open && mobileNavigation.matches) {
			navigation.open = false;
			document.body.classList.remove('menu-open');
			menuButton?.focus();
		}
	});
</script>