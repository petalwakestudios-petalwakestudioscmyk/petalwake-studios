---
import '../styles/studio.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	ogType?: 'website' | 'video.other';
	robots?: string;
	jsonLd?: Record<string, unknown>;
}

const {
	title,
	description,
	image = '/images/petalwake-social.jpg',
	imageAlt = 'Petalwake Studios over a mountain lake at sunrise.',
	imageWidth = 1200,
	imageHeight = 630,
	ogType = 'website',
	robots = 'index, follow',
	jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const organizationId = new URL('/#organization', Astro.site).href;
const organization = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': organizationId,
	name: 'Petalwake Studios',
	url: Astro.site.href,
	logo: new URL('/favicon.svg', Astro.site).href,
	description:
		'Petalwake Studios is an independent creative studio exploring the beauty, complexity, and wonder of the human experience through film, animation, and original media.',
	sameAs: ['https://www.youtube.com/@PetalwakeStudios'],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="canonical" href={canonicalURL.href} />
<meta name="theme-color" content="#123b4a" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Petalwake Studios" />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL.href} />
<meta property="og:image:width" content={imageWidth} />
<meta property="og:image:height" content={imageHeight} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL.href} />
<meta name="twitter:image:alt" content={imageAlt} />
<script type="application/ld+json" set:html={JSON.stringify(organization)} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
