---
import '../styles/studio.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	ogType?: 'website' | 'video.other';
	robots?: string;
	jsonLd?: Record<string, unknown>;
}

const {
	title,
	description,
	image = '/images/petalwake-social.jpg',
	imageAlt = 'Petalwake Studios over a mountain lake at sunrise.',
	imageWidth = 1200,
	imageHeight = 630,
	ogType = 'website',
	robots = 'index, follow',
	jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const isHomepage = Astro.url.pathname === '/';
const organizationId = new URL('/#organization', Astro.site).href;
const organization = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': organizationId,
	name: 'Petalwake Studios',
	url: Astro.site.href,
	logo: new URL('/favicon.svg', Astro.site).href,
	description:
		'Petalwake Studios is an independent Christian creative studio making original films, animation, music, and audiovisual work shaped by wonder, human dignity, and hope in Christ.',
	sameAs: ['https://www.youtube.com/@PetalwakeStudios'],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
{isHomepage && (
	<link
		rel="preload"
		as="image"
		href="/images/petalwake-hero-1536.webp"
		imagesrcset="/images/petalwake-hero-640.webp 640w, /images/petalwake-hero-960.webp 960w, /images/petalwake-hero-1536.webp 1536w"
		imagesizes="100vw"
		fetchpriority="high"
	/>
)}
<link rel="canonical" href={canonicalURL.href} />
<meta name="theme-color" content="#302b4b" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Petalwake Studios" />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL.href} />
<meta property="og:image:width" content={imageWidth} />
<meta property="og:image:height" content={imageHeight} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL.href} />
<meta name="twitter:image:alt" content={imageAlt} />
<script type="application/ld+json" set:html={JSON.stringify(organization)} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<script>
	const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

	if ('IntersectionObserver' in window && !motionPreference.matches) {
		const revealObserver = new IntersectionObserver(
			(entries, observer) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				}
			},
			{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
		);

		document.documentElement.classList.add('has-reveal');
		document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));
	}
</script>
