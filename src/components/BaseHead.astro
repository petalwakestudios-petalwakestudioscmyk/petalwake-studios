import '../styles/studio.css';
import type { Locale } from '../i18n/routing';
import { pairedEnglishRoutes, localizedPath } from '../i18n/routing';

interface Props {
	title: string;
	description: string;
	image?: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	ogType?: 'website' | 'video.other';
	robots?: string;
	language?: Locale;
	includeHreflang?: boolean;
	jsonLd?: Record<string, unknown>;
}

const {
	title,
	description,
	language = 'en',
	image = '/images/petalwake-social.jpg',
	imageAlt = language === 'ja'
		? '山あいの湖を背景にしたPetalwake Studiosのビジュアル。'
		: 'Petalwake Studios over a mountain lake at sunrise.',
	imageWidth = 1200,
	imageHeight = 630,
	ogType = 'website',
	robots = 'index, follow',
	includeHreflang = true,
	jsonLd,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '/ja/';
const englishPath = localizedPath(Astro.url.pathname, 'en');
const japanesePath = localizedPath(Astro.url.pathname, 'ja');
const hasLanguagePair = includeHreflang && pairedEnglishRoutes.includes(englishPath);
const englishURL = new URL(englishPath, Astro.site);
const japaneseURL = new URL(japanesePath, Astro.site);
const organizationId = new URL('/#organization', Astro.site).href;
const organization = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': organizationId,
	name: 'Petalwake Studios',
	url: Astro.site.href,
	logo: new URL('/favicon.svg', Astro.site).href,
	description: language === 'ja'
		? 'Petalwake Studiosは、映画、アニメーション、漫画、音楽、イラスト、映像表現を通して物語を探求するクリエイティブスタジオです。'
		: 'Petalwake Studios is a multidisciplinary creative studio exploring storytelling through film, animation, manga, music, illustration, and experimental image-making.',
	sameAs: ['https://www.youtube.com/@PetalwakeStudios'],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<script is:inline>
	(() => {
		const root = document.documentElement;
		const media = window.matchMedia('(prefers-color-scheme: dark)');
		const choices = ['system', 'light', 'dark'];
		let choice = 'system';
		try {
			const saved = localStorage.getItem('petalwake-appearance');
			if (choices.includes(saved)) choice = saved;
		} catch (error) {
			console.warn('The saved appearance preference could not be read in this browser.', error);
		}

		const apply = (preference) => {
			choice = choices.includes(preference) ? preference : 'system';
			const theme = choice === 'system' ? (media.matches ? 'dark' : 'light') : choice;
			root.dataset.themeChoice = choice;
			root.dataset.theme = theme;
			const updateThemeColor = () => {
				document.querySelector('meta[name="theme-color"]')?.setAttribute(
					'content',
					theme === 'dark' ? '#171821' : '#f0ece9',
				);
			};
			if (document.querySelector('meta[name="theme-color"]')) {
				updateThemeColor();
			} else {
				document.addEventListener('DOMContentLoaded', updateThemeColor, { once: true });
			}
			window.dispatchEvent(new CustomEvent('petalwake:themechange', { detail: { theme, choice } }));
		};

		const setPreference = (preference) => {
			const nextPreference = choices.includes(preference) ? preference : 'system';
			try {
				if (nextPreference === 'system') {
					localStorage.removeItem('petalwake-appearance');
				} else {
					localStorage.setItem('petalwake-appearance', nextPreference);
				}
			} catch (error) {
				console.warn('The appearance preference could not be saved in this browser.', error);
			}
			apply(nextPreference);
		};

		window.petalwakeAppearance = { setPreference };
		apply(choice);
		media.addEventListener('change', () => {
			if (choice === 'system') apply('system');
		});
	})();
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator" content={Astro.generator} />
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
{isHomepage && (
	<link
		rel="preload"
		as="image"
		href="/images/petalwake-hero-1536.webp"
		imagesrcset="/images/petalwake-hero-640.webp 640w, /images/petalwake-hero-960.webp 960w, /images/petalwake-hero-1536.webp 1536w"
		imagesizes="100vw"
		fetchpriority="high"
	/>
)}
<link rel="canonical" href={canonicalURL.href} />
{hasLanguagePair && (
	<>
		<link rel="alternate" hreflang="en" href={englishURL.href} />
		<link rel="alternate" hreflang="ja" href={japaneseURL.href} />
		<link rel="alternate" hreflang="x-default" href={englishURL.href} />
	</>
)}
<meta name="theme-color" content="#25213d" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={language === 'ja' ? 'ja_JP' : 'en_US'} />
<meta property="og:locale:alternate" content={language === 'ja' ? 'en_US' : 'ja_JP'} />
<meta property="og:site_name" content="Petalwake Studios" />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL.href} />
<meta property="og:image:width" content={imageWidth} />
<meta property="og:image:height" content={imageHeight} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL.href} />
<meta name="twitter:image:alt" content={imageAlt} />
<script type="application/ld+json" set:html={JSON.stringify(organization)} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

<script>
	const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');

	if ('IntersectionObserver' in window && !motionPreference.matches) {
		const revealObserver = new IntersectionObserver(
			(entries, observer) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				}
			},
			{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
		);

		document.documentElement.classList.add('has-reveal');
		document.querySelectorAll('[data-reveal]').forEach((element) => revealObserver.observe(element));
	}
</script>
