---
import { SITE_TITLE, YOUTUBE_CHANNEL } from '../consts';
import { common } from '../i18n/common';
import { localeFromPath, localizedPath } from '../i18n/routing';

const year = new Date().getFullYear();
const locale = localeFromPath(Astro.url.pathname);
const labels = common[locale];
---

<footer class="site-footer">
	<a class="site-footer__name" href={localizedPath('/', locale)}>{SITE_TITLE}</a>
	<p>{locale === 'ja' ? '物語が、心に驚きを呼び覚ます。' : 'Stories That Awaken Wonder.'}</p>
	<p class="site-footer__discipline">{labels.footerDiscipline}</p>
	<nav aria-label={labels.footerNavLabel}>
		<a href={localizedPath('/', locale)}>{labels.home}</a>
		<a href={localizedPath('/work/', locale)}>{labels.films}</a>
		<a href={localizedPath('/about/', locale)}>{labels.about}</a>
		<a href={localizedPath('/gospel/', locale)}>{labels.gospel}</a>
		<a href={localizedPath('/contact/', locale)}>{labels.contact}</a>
		<a href={localizedPath('/privacy/', locale)}>{labels.privacy}</a>
		<a href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer">{labels.visitYouTube}</a>
	</nav>
	<small>© {year} {SITE_TITLE}</small>
</footer>