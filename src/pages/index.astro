---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_DESCRIPTION, SITE_TITLE, YOUTUBE_CHANNEL } from '../consts';
import { FILMS } from '../data/films';

const featuredFilm = FILMS[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} | Animation & Visual Storytelling`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body class="home-page">
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader />
		<main id="main-content" tabindex="-1">
			<section class="hero" aria-label="Petalwake Studios: Stories That Awaken Wonder">
				<div class="hero__art">
					<img
						src="/images/petalwake-mountain-lake-hero.webp"
						srcset="/images/petalwake-mountain-lake-hero-640.webp 640w, /images/petalwake-mountain-lake-hero-960.webp 960w, /images/petalwake-mountain-lake-hero-1440.webp 1440w, /images/petalwake-mountain-lake-hero.webp 1983w"
						sizes="100vw"
						alt="Petalwake Studios identity artwork: a floral emblem above a mountain lake at sunset, with the studio name and Stories That Awaken Wonder tagline."
						width="1983"
						height="793"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
				<div class="hero__content">
					<p class="hero__descriptor">
						Original stories. Human questions. A little room for wonder.
					</p>
					<div class="hero__actions">
						<a class="button button--primary" href="#work">Explore Our Work <span aria-hidden="true">↓</span></a>
						<a class="button button--quiet" href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer">
							Watch on YouTube <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="studio-intro section-wrap" aria-labelledby="studio-intro-title">
				<p class="eyebrow">Petalwake Studios</p>
				<div class="studio-intro__content">
					<h2 id="studio-intro-title">Stories begin<br /><em>with people.</em></h2>
					<p class="studio-intro__lead">
						Petalwake Studios is an independent, evangelical Christian creative studio creating
						thoughtful films and original media that explore love, loss, forgiveness, hope,
						and the human experience.
					</p>
					<p>
						Our stories are shaped by a Christian understanding of grace, suffering, and the
						possibility of renewal, but they do not need to be sermons to be honest, beautiful,
						and spiritually resonant.
					</p>
				</div>
			</section>

			<section class="creative-values section-wrap" aria-labelledby="creative-values-title">
				<div class="creative-values__intro">
					<p class="eyebrow">Creative values</p>
					<h2 id="creative-values-title">Wonder. Humanity. Hope.</h2>
				</div>
				<div class="creative-values__grid">
					<article>
						<h3>Wonder</h3>
						<p>Seeing the familiar differently, and rediscovering what is extraordinary in the ordinary.</p>
					</article>
					<article>
						<h3>Humanity</h3>
						<p>Making space for relationships, memory, choices, loss, love, and the complexity of being human.</p>
					</article>
					<article>
						<h3>Hope</h3>
						<p>Leaving room for beauty, reflection, reconciliation, and possibility beyond immediate circumstances.</p>
					</article>
				</div>
				<p class="creative-values__note">
					These are guiding interests, not a checklist every project has to meet.
				</p>
			</section>

			<section class="what-we-create section-wrap" aria-labelledby="create-title">
				<p class="eyebrow">What we create</p>
				<div class="what-we-create__content">
					<h2 id="create-title">Original stories,<br /><em>thoughtfully told.</em></h2>
					<p>
						Petalwake develops original stories and audiovisual work centered on character,
						consequence, and the questions that remain with us. We explore cinematic imagery,
						animation, music, and atmosphere as each project calls for, leaving room for stories
						to breathe and audiences to reflect.
					</p>
				</div>
			</section>

			<section class="work section-wrap" id="work" aria-labelledby="work-title">
				<div class="section-heading">
					<p class="eyebrow">Featured work</p>
					<h2 id="work-title">Featured Film</h2>
				</div>
				<article class="film-feature">
					<a class="film-feature__image" href={`/work/${featuredFilm.slug}/`} aria-label={`Explore the story of ${featuredFilm.title}`}>
						<img
							src={featuredFilm.thumbnail}
							srcset="/images/the-last-winter-thumbnail-640.webp 640w, /images/the-last-winter-thumbnail.webp 1280w"
							sizes="(max-width: 760px) calc(100vw - 48px), 60vw"
							alt={featuredFilm.thumbnailAlt}
							width={featuredFilm.imageWidth}
							height={featuredFilm.imageHeight}
							loading="lazy"
							decoding="async"
						/>
						<span class="film-feature__play" aria-hidden="true">↗</span>
					</a>
					<div class="film-feature__info">
						<p class="eyebrow">Animated short film</p>
						<h3>{featuredFilm.title}</h3>
						<p>{featuredFilm.shortDescription}</p>
						<div class="film-feature__links">
							<a href={featuredFilm.youtubeUrl} target="_blank" rel="noopener noreferrer">
								Watch {featuredFilm.title}
							</a>
							<a href={`/work/${featuredFilm.slug}/`}>Explore the Story</a>
						</div>
					</div>
				</article>
				<p class="work__all"><a href="/work/">View All Work <span aria-hidden="true">↗</span></a></p>
			</section>

			<section class="philosophy section-wrap" aria-labelledby="philosophy-title">
				<p class="eyebrow">Why we tell stories</p>
				<div class="philosophy__content">
					<h2 id="philosophy-title">Some stories<br /><em>follow us home.</em></h2>
					<p>
						Some stories entertain us for an evening. Others follow us home. We are drawn to the
						second kind: stories that let us enter an experience beyond our own and remind us how
						little we can know of another person from the outside. A life is rarely as simple as
						its first impression.
					</p>
					<p>
						We are interested in imperfect people facing choices they cannot easily undo; in love
						tested by loss, memory shadowed by regret, and forgiveness when forgetting is impossible.
						We want to make room for beauty that still matters when life hurts, and for hope that
						does not ask us to pretend everything is fine.
					</p>
					<p>
						We do not expect a story to settle every difficult question. We hope to make work worth
						thinking about, sharing, and carrying with us—stories that can open a conversation
						between a character, another perspective, and the people beside us.
					</p>
				</div>
			</section>

			<section class="story-beliefs section-wrap" aria-labelledby="story-beliefs-title">
				<p class="eyebrow">What we believe about stories</p>
				<div class="story-beliefs__content">
					<h2 id="story-beliefs-title">Honest stories<br /><em>leave room.</em></h2>
					<div class="story-beliefs__grid">
						<p><strong>People are worth understanding.</strong> Compassion and moral responsibility can belong in the same story.</p>
						<p><strong>Pain deserves honesty.</strong> Not every loss can be undone or every consequence neatly resolved.</p>
						<p><strong>Hope can be honest, too.</strong> It can begin quietly, before a difficult season has passed.</p>
					</div>
					<a href="/about/">About Petalwake Studios <span aria-hidden="true">↗</span></a>
				</div>
			</section>

			<section class="current-work section-wrap" aria-labelledby="current-work-title">
				<p class="eyebrow">Work</p>
				<div class="current-work__content">
					<h2 id="current-work-title">A beginning,<br /><em>not a catalogue.</em></h2>
					<p>
						Petalwake Studios is still at the beginning. <em>The Last Winter</em> is one story we
						can share today; other work will find its place here as it is ready.
					</p>
					<a href="/work/">View All Work <span aria-hidden="true">↗</span></a>
				</div>
			</section>

			<section class="about section-wrap" id="about" aria-labelledby="about-title">
				<p class="eyebrow">About Petalwake</p>
				<div class="about__content">
					<h2 id="about-title">Stories That<br /><em>Awaken Wonder.</em></h2>
					<p>
						Wonder can be a quiet moment of recognition: seeing another person more fully, or
						finding a little possibility in a season that has not yet passed.
					</p>
					<p><a href="/about/">About Petalwake Studios</a></p>
					<p><a href="/gospel/">Read the Gospel</a></p>
				</div>
			</section>

			<section class="watch section-wrap" aria-labelledby="watch-title">
				<p class="eyebrow">Follow the journey</p>
				<div class="watch__content">
					<h2 id="watch-title">Still at the<br /><em>beginning.</em></h2>
					<p>Follow along as new stories, films, artwork, and glimpses behind the process take shape.</p>
					<a class="button button--primary" href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer">
						Watch on YouTube <span aria-hidden="true">↗</span>
					</a>
				</div>
			</section>
		</main>
		<SiteFooter />
	</body>
</html>
