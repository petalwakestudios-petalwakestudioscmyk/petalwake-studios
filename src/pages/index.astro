---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { FILMS } from '../data/films';
import { FEATURED_ARTWORK } from '../data/artwork';

const featuredFilm = FILMS.find((film) => film.featured);
if (!featuredFilm) throw new Error('The featured film is missing from src/data/films.ts.');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} | Stories That Awaken Wonder`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body class="home-page">
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader />
		<main id="main-content" tabindex="-1">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero__art">
					<img
						src="/images/petalwake-hero-1536.webp"
						srcset="/images/petalwake-hero-640.webp 640w, /images/petalwake-hero-960.webp 960w, /images/petalwake-hero-1536.webp 1536w"
						sizes="100vw"
						alt="A mountain lake at sunset, framed by flowering branches and drifting petals."
						width="1536"
						height="1024"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
				<div class="hero__atmosphere" aria-hidden="true"></div>
				<div class="hero__content">
					<p class="eyebrow hero__overline" data-hero-enter>A multidisciplinary creative studio</p>
					<h1 class="hero__title" id="hero-title" data-hero-enter>
						<span>Petalwake</span>
						<span>Studios</span>
					</h1>
					<p class="hero__descriptor" data-hero-enter>Stories That Awaken Wonder.</p>
					<a class="button button--primary" href="/work/" data-hero-enter>
						Explore the Films <span aria-hidden="true">↗</span>
					</a>
				</div>
				<a class="hero__scroll" href="#featured-work" aria-label="Scroll to featured work">
					<span aria-hidden="true"></span>
					Featured work
				</a>
			</section>

			<section class="work section-wrap" id="featured-work" aria-labelledby="work-title" data-reveal>
				<div class="section-heading">
					<p class="eyebrow">01 / Featured work</p>
					<h2 id="work-title">A story in winter.</h2>
				</div>
				<article class="film-feature">
					<a class="film-feature__image" href={`/work/${featuredFilm.slug}/`} aria-label={`Explore the story of ${featuredFilm.title}`}>
						<img
							src={featuredFilm.thumbnail}
							srcset="/images/the-last-winter-thumbnail-640.webp 640w, /images/the-last-winter-thumbnail.webp 1280w"
							sizes="(max-width: 760px) calc(100vw - 48px), 60vw"
							alt={featuredFilm.thumbnailAlt}
							width={featuredFilm.imageWidth}
							height={featuredFilm.imageHeight}
							loading="lazy"
							decoding="async"
						/>
						<span class="film-feature__play" aria-hidden="true">↗</span>
					</a>
					<div class="film-feature__info">
						<p class="eyebrow">{featuredFilm.type}</p>
						<h3>{featuredFilm.title}</h3>
						<p class="film-feature__logline">{featuredFilm.shortDescription}</p>
						<div class="film-feature__links">
							<a href={featuredFilm.youtubeUrl} target="_blank" rel="noopener noreferrer">
								Watch the film <span aria-hidden="true">↗</span>
							</a>
							<a href={`/work/${featuredFilm.slug}/`}>Enter the story <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</article>
				<p class="work__all"><a href="/work/">Explore all films <span aria-hidden="true">↗</span></a></p>
			</section>

			<section class="home-artwork section-wrap" aria-labelledby="home-artwork-title" data-reveal>
				<div class="section-heading">
					<div>
						<p class="eyebrow">02 / Featured artwork</p>
						<h2 id="home-artwork-title">Small reflections in light.</h2>
					</div>
					<a class="text-link" href="/artwork/">View the collection <span aria-hidden="true">↗</span></a>
				</div>
				<div class="home-artwork__grid">
					{FEATURED_ARTWORK.map((item) => (
						<a class="home-artwork__card" href="/artwork/">
							<img src={item.thumbnail} srcset={`${item.thumbnail} 640w, ${item.mediumThumbnail} 768w, ${item.image} 1024w`} sizes="(min-width: 1000px) 28vw, (min-width: 601px) 42vw, calc(100vw - 48px)" alt={item.alt} width="1024" height="1536" loading="lazy" decoding="async" />
							<span>{item.collection}</span>
							<strong>{item.title}</strong>
						</a>
					))}
				</div>
			</section>

			<section class="creative-portfolio section-wrap" aria-labelledby="creative-portfolio-title" data-reveal>
				<div class="creative-portfolio__heading">
					<p class="eyebrow">02 / An open creative practice</p>
					<h2 id="creative-portfolio-title">Many forms.<br /><em>One sense of wonder.</em></h2>
					<p>
						Stories can unfold through moving image, music, illustration, or experiments in sound
						and light. Petalwake makes room for each idea to find its own form.
					</p>
				</div>
				<div class="creative-portfolio__forms" aria-label="Creative directions">
					<div><span>01</span><h3>Film & animation</h3></div>
					<div><span>02</span><h3>Music & sound</h3></div>
					<div><span>03</span><h3>Illustrated stories</h3></div>
					<div><span>04</span><h3>Experimental image-making</h3></div>
				</div>
				<p class="creative-portfolio__note">The portfolio grows as new work is ready to share.</p>
			</section>

			<section class="studio-intro section-wrap" aria-labelledby="studio-intro-title" data-reveal>
				<p class="eyebrow">03 / The studio</p>
				<div class="studio-intro__content">
					<h2 id="studio-intro-title">A home for stories<br /><em>still unfolding.</em></h2>
					<p class="studio-intro__lead">
						Petalwake Studios is a multidisciplinary creative studio guided by storytelling,
						imagination, visual art, and meaningful creative experiences.
					</p>
					<p>
						From intimate human stories to folklore, mythology, and history, we follow ideas toward
						the forms that let them resonate. There is room here for what has been made—and for
						what is yet to come.
					</p>
					<a class="text-link" href="/about/">Meet the studio <span aria-hidden="true">↗</span></a>
				</div>
			</section>

			<section class="home-purpose section-wrap" aria-labelledby="home-purpose-title" data-reveal>
				<p class="eyebrow">Faith & meaning</p>
				<div>
					<h2 id="home-purpose-title">A foundation of<br /><em>lasting hope.</em></h2>
					<p>
						The Christian faith is part of Petalwake's foundation and its understanding of beauty,
						human dignity, and hope. The Gospel page shares that message in full.
					</p>
					<div class="home-purpose__links">
						<a href="/gospel/">Read the Gospel <span aria-hidden="true">↗</span></a>
						<a href="/contact/">Get in touch <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>
		</main>
		<SiteFooter />
	</body>
</html>
