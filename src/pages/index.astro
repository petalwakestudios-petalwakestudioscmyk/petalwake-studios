---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_DESCRIPTION, SITE_TITLE, YOUTUBE_CHANNEL } from '../consts';
import { FILMS } from '../data/films';

const featuredFilm = FILMS[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${SITE_TITLE} | Animation & Visual Storytelling`}
			description={SITE_DESCRIPTION}
		/>
	</head>
	<body class="home-page">
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader />
		<main id="main-content" tabindex="-1">
			<section class="hero" aria-label="Petalwake Studios: Stories That Awaken Wonder">
				<div class="hero__art">
					<img
						src="/images/petalwake-mountain-lake-hero.webp"
						srcset="/images/petalwake-mountain-lake-hero-640.webp 640w, /images/petalwake-mountain-lake-hero-960.webp 960w, /images/petalwake-mountain-lake-hero-1440.webp 1440w, /images/petalwake-mountain-lake-hero.webp 1983w"
						sizes="100vw"
						alt="Petalwake Studios identity artwork: a floral emblem above a mountain lake at sunset, with the studio name and Stories That Awaken Wonder tagline."
						width="1983"
						height="793"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
				<div class="hero__content" data-reveal>
					<p class="eyebrow">Independent Christian creative studio</p>
					<p class="hero__descriptor">
						Original films and audiovisual stories shaped by wonder, human dignity, and hope in Christ.
					</p>
					<div class="hero__actions">
						<a class="button button--primary" href="#work">Discover the films <span aria-hidden="true">↓</span></a>
						<a class="button button--quiet" href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer">
							Visit YouTube <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="studio-intro section-wrap" aria-labelledby="studio-intro-title" data-reveal>
				<p class="eyebrow">Petalwake Studios</p>
				<div class="studio-intro__content">
					<h2 id="studio-intro-title">Stories begin<br /><em>with people.</em></h2>
					<p class="studio-intro__lead">
						We are an independent Christian creative studio making original films, animation, music,
						and audiovisual work.
					</p>
					<p>
						Our work grows from the conviction that every person bears God's image, that beauty
						belongs to the Creator, and that lasting hope is found in Jesus Christ.
					</p>
					<a class="text-link" href="/about/">Meet the studio <span aria-hidden="true">↗</span></a>
				</div>
			</section>

			<section class="creative-values section-wrap" aria-labelledby="creative-values-title" data-reveal>
				<div class="creative-values__intro">
					<p class="eyebrow">A way of seeing</p>
					<h2 id="creative-values-title">Wonder, humanity,<br /><em>and hope.</em></h2>
				</div>
				<div class="creative-values__grid">
					<article>
						<span>01</span>
						<h3>Wonder</h3>
						<p>Creation's beauty invites us to look beyond ourselves to its Maker, the source of all that is good.</p>
					</article>
					<article>
						<span>02</span>
						<h3>Humanity</h3>
						<p>Image-bearers are worthy of care, and our choices carry real weight for one another.</p>
					</article>
					<article>
						<span>03</span>
						<h3>Hope</h3>
						<p>Jesus Christ meets a world marked by sin and suffering with forgiveness, redemption, and life.</p>
					</article>
				</div>
			</section>

			<section class="work section-wrap" id="work" aria-labelledby="work-title" data-reveal>
				<div class="section-heading">
					<p class="eyebrow">Featured work</p>
					<h2 id="work-title">A story in winter.</h2>
				</div>
				<article class="film-feature">
					<a class="film-feature__image" href={`/work/${featuredFilm.slug}/`} aria-label={`Explore the story of ${featuredFilm.title}`}>
						<img
							src={featuredFilm.thumbnail}
							srcset="/images/the-last-winter-thumbnail-640.webp 640w, /images/the-last-winter-thumbnail.webp 1280w"
							sizes="(max-width: 760px) calc(100vw - 48px), 60vw"
							alt={featuredFilm.thumbnailAlt}
							width={featuredFilm.imageWidth}
							height={featuredFilm.imageHeight}
							loading="lazy"
							decoding="async"
						/>
						<span class="film-feature__play" aria-hidden="true">↗</span>
					</a>
					<div class="film-feature__info">
						<p class="eyebrow">Animated short film</p>
						<h3>{featuredFilm.title}</h3>
						<p class="film-feature__logline">{featuredFilm.shortDescription}</p>
						<div class="film-feature__links">
							<a href={featuredFilm.youtubeUrl} target="_blank" rel="noopener noreferrer">
								Watch the film <span aria-hidden="true">↗</span>
							</a>
							<a href={`/work/${featuredFilm.slug}/`}>Enter the story <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</article>
				<p class="work__all"><a href="/work/">Explore the film collection <span aria-hidden="true">↗</span></a></p>
			</section>

			<section class="home-purpose section-wrap" aria-labelledby="home-purpose-title" data-reveal>
				<p class="eyebrow">The ground beneath the stories</p>
				<div>
					<h2 id="home-purpose-title">Made by the Creator.<br /><em>Hope found in Christ.</em></h2>
					<p>
						God is the source of beauty, truth, and goodness. The gospel of Jesus Christ is the
						foundation of our hope in a world marked by sin and suffering.
					</p>
					<div class="home-purpose__links">
						<a href="/gospel/">Read the gospel <span aria-hidden="true">↗</span></a>
						<a href="/contact/">Get in touch <span aria-hidden="true">↗</span></a>
						<a href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer">Follow on YouTube <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>
		</main>
		<SiteFooter />
	</body>
</html>
