---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
			image="/images/petalwake-mountain-lake-hero.webp"
		/>
	</head>
	<body class="about-page">
		<SiteHeader />
		<main>
			<p class="eyebrow">Independent animation studio</p>
			<h1>Stories That Awaken Wonder.</h1>
			<p>
				Petalwake Studios is an independent animation studio creating cinematic stories
				and imagined worlds shaped by nature, wonder, and discovery.
			</p>
			<p class="about-page__focus">Animation <span>·</span> Cinematic storytelling <span>·</span> Imagined worlds</p>
			<p><a href="/#work">Explore our work <span aria-hidden="true">↗</span></a></p>
		</main>
		<SiteFooter />
	</body>
</html>
