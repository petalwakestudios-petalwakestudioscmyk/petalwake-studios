---
import BaseHead from '../../components/BaseHead.astro';
import ProductionNotes from '../../components/ProductionNotes.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SITE_TITLE, YOUTUBE_CHANNEL } from '../../consts';
import { FILMS } from '../../data/films';

const film = FILMS.find(({ slug }) => slug === 'the-last-winter');
if (!film) throw new Error('The Last Winter film entry is missing from src/data/films.ts.');
if (!film.productionSteps) throw new Error('The Last Winter production steps are missing from src/data/films.ts.');

const description =
	'An elderly woman visits the dying former husband who betrayed her decades ago. The Last Winter explores memory, responsibility, and forgiveness.';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${film.title} | ${SITE_TITLE}`}
			description={description}
			image={film.thumbnail}
			imageAlt={film.thumbnailAlt}
			imageWidth={film.imageWidth}
			imageHeight={film.imageHeight}
			ogType="video.other"
		/>
	</head>
	<body class="film-page">
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader />
		<main id="main-content" tabindex="-1">
			<section class="project-hero" aria-labelledby="film-title" data-reveal>
				<div class="project-hero__art">
					<img
						src={film.heroImage}
						srcset="/images/the-last-winter-thumbnail-640.webp 640w, /images/the-last-winter-thumbnail.webp 1280w"
						sizes="(max-width: 760px) calc(100vw - 48px), 60vw"
						alt={film.heroImageAlt}
						width={film.imageWidth}
						height={film.imageHeight}
						fetchpriority="high"
						decoding="async"
					/>
					<span class="project-hero__art-caption">An animated short film by Petalwake Studios</span>
				</div>
				<div class="project-hero__copy">
					<p class="eyebrow">Animated short film</p>
					<h1 id="film-title">{film.title}</h1>
					<p class="project-hero__logline">{film.logline}</p>
					<div class="project-hero__links">
						<a class="button button--primary" href="#watch-film">Watch the film <span aria-hidden="true">↓</span></a>
						<a href={film.youtubeUrl} target="_blank" rel="noopener noreferrer">
							Open on YouTube <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>

			<section class="project-copy" id="synopsis" aria-labelledby="synopsis-title" data-reveal>
				<p class="eyebrow">The story</p>
				<h2 id="synopsis-title">A visit after many years</h2>
				{film.synopsis.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
			</section>

			<section class="project-watch-film" aria-labelledby="watch-film-title" data-reveal>
				<div class="project-watch-film__heading">
					<p class="eyebrow">The complete short film</p>
					<h2 id="watch-film-title">Watch <em>{film.title}</em></h2>
				</div>
				<div
					class="film-page__player"
					id="watch-film"
					data-youtube-player
					data-video-id={film.youtubeVideoId}
					data-video-title={film.title}
				>
					<button class="film-page__poster" type="button" aria-label={`Play ${film.title}`}>
						<img
							src={film.thumbnail}
							srcset="/images/the-last-winter-thumbnail-640.webp 640w, /images/the-last-winter-thumbnail.webp 1280w"
							sizes="(max-width: 760px) calc(100vw - 48px), 72vw"
							alt=""
							width={film.imageWidth}
							height={film.imageHeight}
							loading="lazy"
							decoding="async"
						/>
						<span class="film-page__play">Play film <span aria-hidden="true">▶</span></span>
					</button>
				</div>
				<p class="project-watch-film__fallback">
					Prefer YouTube? <a href={film.youtubeUrl} target="_blank" rel="noopener noreferrer">Watch the film there <span aria-hidden="true">↗</span></a>
				</p>
			</section>

			<section class="project-copy project-copy--light" aria-labelledby="about-story-title" data-reveal>
				<p class="eyebrow">Themes and interpretation</p>
				<h2 id="about-story-title">What can forgiveness change?</h2>
				{film.aboutStory.split('\n\n').map((paragraph) => <p>{paragraph}</p>)}
			</section>

			<section class="project-themes section-wrap" aria-labelledby="themes-title" data-reveal>
				<p class="eyebrow">Threads in the story</p>
				<h2 id="themes-title">What remains.</h2>
				<div class="project-themes__grid">
					{film.themes.map((theme) => (
						<article>
							<h3>{theme.title}</h3>
							<p>{theme.description}</p>
						</article>
					))}
				</div>
			</section>

			<section class="project-visual" aria-labelledby="visual-language-title" data-reveal>
				<p class="eyebrow">Visual language</p>
				<div>
					<h2 id="visual-language-title">What remains in the frame</h2>
					<p>{film.visualLanguage}</p>
				</div>
			</section>

			<section class="project-production" aria-labelledby="production-title" data-reveal>
				<p class="eyebrow">Behind the film</p>
				<div>
					<h2 id="production-title">Made through a considered process.</h2>
					<p>
						The creator conceived the story and narrative sequence, then used generative tools
						for the visuals and music. Scene selection, arrangement, editing, and final mastering
						shaped the finished film.
					</p>
					<ProductionNotes steps={film.productionSteps} />
				</div>
			</section>

			<section class="project-christian" aria-labelledby="christian-perspective-title" data-reveal>
				<p class="eyebrow">Faith and reflection</p>
				<div>
					<h2 id="christian-perspective-title">Forgiveness, responsibility, and grace.</h2>
					<p>
						<em>The Last Winter</em> is a human story, not a direct biblical allegory. Its
						questions about harm, responsibility, and forgiveness resonate with Christian
						teaching. Scripture calls Christians to forgive one another as God in Christ forgave
						us (Ephesians 4:32; Colossians 3:13).
					</p>
					<blockquote>
						<p>“God commendeth his love toward us, in that, while we were yet sinners, Christ died for us.”</p>
						<cite>Romans 5:8 (King James Version)</cite>
					</blockquote>
					<p>
						God's forgiveness is a gift of grace received through repentance and faith in Christ;
						we do not earn it by forgiving other people. Human forgiveness does not erase harm or
						require anyone to remain in an unsafe relationship, restore trust, or reconcile without
						truth and safety. Psalm 103:10-12 speaks of the mercy God shows those who fear Him.
					</p>
					<a href="/gospel/">Explore the gospel of Jesus Christ <span aria-hidden="true">↗</span></a>
				</div>
			</section>

			<section class="project-reflection" aria-labelledby="reflection-title" data-reveal>
				<p class="eyebrow">A question to carry with you</p>
				<h2 id="reflection-title">{film.reflectionQuestion}</h2>
				<details class="project-reflection__more">
					<summary>Explore a few more questions</summary>
					<ul>
						<li>How can compassion and accountability exist together?</li>
						<li>What is the difference between forgiveness, restored trust, and reconciliation?</li>
						<li>What might hope look like when the consequences of the past remain?</li>
					</ul>
				</details>
			</section>

			<section class="project-watch section-wrap" aria-labelledby="watch-title" data-reveal>
				<p class="eyebrow">Further exploration</p>
				<div>
					<h2 id="watch-title">Carry the conversation further.</h2>
					<p>
						For a private conversation about the film or its questions, use the contact form. To
						explore the Christian hope behind our work, read the gospel.
					</p>
					<a class="button button--primary" href="/gospel/">Read the gospel <span aria-hidden="true">↗</span></a>
					<a class="project-watch__channel" href="/contact/">
						Use the contact form <span aria-hidden="true">↗</span>
					</a>
					<a class="project-watch__channel" href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer">
						Visit Petalwake Studios on YouTube <span aria-hidden="true">↗</span>
					</a>
				</div>
			</section>

			<nav class="project-back" aria-label="Project navigation">
				<a href="/work/"><span aria-hidden="true">←</span> Back to Work</a>
			</nav>
			<noscript>
				<p class="project-noscript">
					<a href={film.youtubeUrl} target="_blank" rel="noopener noreferrer">
						Watch {film.title} on YouTube
					</a>
				</p>
			</noscript>
		</main>
		<SiteFooter />
	</body>
</html>

<script>
	const player = document.querySelector<HTMLElement>('[data-youtube-player]');
	const playButton = player?.querySelector('button');

	playButton?.addEventListener('click', () => {
		if (!player) return;

		const videoId = player.dataset.videoId;
		const videoTitle = player.dataset.videoTitle;
		if (!videoId || !videoTitle) {
			console.error('The film player is missing its verified YouTube video details.');
			return;
		}

		const iframe = document.createElement('iframe');
		iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}`;
		iframe.title = `${videoTitle} video player`;
		iframe.width = '1280';
		iframe.height = '720';
		iframe.loading = 'lazy';
		iframe.allow = 'encrypted-media; picture-in-picture; web-share';
		iframe.referrerPolicy = 'strict-origin-when-cross-origin';
		iframe.allowFullscreen = true;
		player.replaceChildren(iframe);
	});
</script>
