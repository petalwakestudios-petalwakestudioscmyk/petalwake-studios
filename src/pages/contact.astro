---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CONTACT_DESCRIPTION, SITE_TITLE, TURNSTILE_SITE_KEY, YOUTUBE_CHANNEL } from '../consts';
import { CONTACT_TOPICS } from '../lib/contact-contract';
import { contactTopicLabels } from '../i18n/contact-topics';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Contact | ${SITE_TITLE}`}
			description={CONTACT_DESCRIPTION}
		/>
	</head>
	<body class="contact-page">
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader />
		<main id="main-content" tabindex="-1" data-reveal>
			<p class="eyebrow">Contact</p>
			<h1>Start a conversation.</h1>
			<p>
				Questions about films, the creative process, Christianity, collaboration, or a thought
				you would like to share are welcome. Use the form below to send a message securely.
			</p>
			<div class="contact-card">
				<p class="contact-form__note">
					This form sends your message through a secure server-side delivery pipeline and does not
					store your message on this site.
				</p>
				<noscript>
					<p class="contact-form__note">
						JavaScript is required for the secure contact form. Please enable scripting and try again.
					</p>
				</noscript>
				<form
					id="contact-form"
					class="contact-form"
					method="post"
					action="/api/contact"
					novalidate
					data-turnstile-site-key={TURNSTILE_SITE_KEY}
					data-locale="en"
				>
					<div class="contact-form__row">
						<label>
							<span>Name</span>
							<input type="text" name="name" autocomplete="name" required maxlength="120" />
						</label>
						<label>
							<span>Email address</span>
							<input type="email" name="email" autocomplete="email" required maxlength="254" />
						</label>
					</div>
					<label>
						<span>Inquiry topic</span>
						<select name="topic" required>
							<option value="">Select a topic</option>
							{CONTACT_TOPICS.map((topic) => <option value={topic}>{contactTopicLabels.en[topic]}</option>)}
						</select>
					</label>
					<label>
						<span>Message</span>
						<textarea name="message" rows="6" required maxlength="2500"></textarea>
					</label>
					<div class="contact-form__honeypot" aria-hidden="true">
						<label for="contact-website">Leave this blank</label>
						<input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
					</div>
					<div class="contact-form__turnstile">
						<div id="contact-turnstile" aria-live="polite"></div>
						{TURNSTILE_SITE_KEY ? null : <p class="contact-form__note">CAPTCHA is currently unavailable. Please try again later.</p>}
					</div>
					<p class="contact-form__privacy">
						By sending this form, you agree to our <a href="/privacy/">Privacy policy</a>.
						We process submitted details and technical request information to verify and protect submissions and respond to your inquiry.
					</p>
					<div class="contact-form__actions">
						<button class="button button--primary" type="submit">Send message</button>
					</div>
					<p id="contact-form-status" class="contact-form__status" aria-live="polite"></p>
				</form>
			</div>
			<p class="contact-page__note">
				For new releases and studio updates, follow Petalwake Studios on
				<a href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer">YouTube</a>.
			</p>
		</main>
		<SiteFooter />
	</body>
</html>

<script src="../scripts/contact-form.ts"></script>
