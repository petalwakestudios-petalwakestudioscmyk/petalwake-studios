---
import BaseHead from '../components/BaseHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { CONTACT_DESCRIPTION, SITE_TITLE, STUDIO_EMAIL, YOUTUBE_CHANNEL } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Contact | ${SITE_TITLE}`}
			description={CONTACT_DESCRIPTION}
		/>
	</head>
	<body class="contact-page">
		<a class="skip-link" href="#main-content">Skip to content</a>
		<SiteHeader />
		<main id="main-content" tabindex="-1" data-reveal>
			<p class="eyebrow">Contact</p>
			<h1>Start a conversation.</h1>
			<p>
				Questions about films, the creative process, Christianity, collaboration, or a thought
				you would like to share are welcome. Write directly to
				<a href={`mailto:${STUDIO_EMAIL}`}>{STUDIO_EMAIL}</a>.
			</p>
			<div class="contact-card">
				<p class="contact-form__note">
					This form prepares an email in your email app; it does not send or store messages on
					this site. If your email app does not open, write to {STUDIO_EMAIL}.
				</p>
				<noscript>
					<p class="contact-form__note">
						JavaScript is unavailable, so please email <a href={`mailto:${STUDIO_EMAIL}`}>{STUDIO_EMAIL}</a> directly.
					</p>
				</noscript>
				<form
					id="contact-form"
					class="contact-form"
					data-required-message="Please add your name, email, and message before sending."
					data-subject-prefix="Petalwake Studios inquiry"
					data-prepared-message="Check your email app for the prepared message. Nothing has been submitted to this site."
					data-name-label="Name"
					data-email-label="Email"
					data-topic-label="Topic"
					data-message-label="Message"
					data-email-address={STUDIO_EMAIL}
				>
					<div class="contact-form__row">
						<label>
							<span>Name</span>
							<input type="text" name="name" autocomplete="name" required />
						</label>
						<label>
							<span>Email</span>
							<input type="email" name="email" autocomplete="email" required />
						</label>
					</div>
					<label>
						<span>Topic</span>
						<select name="topic">
							<option value="General inquiry">General inquiry</option>
							<option value="Question about a film">Question about a film</option>
							<option value="Question about the creative process">Question about the creative process</option>
							<option value="Question about Christianity or following Jesus">Question about Christianity or following Jesus</option>
							<option value="Collaboration inquiry">Collaboration inquiry</option>
							<option value="Feedback or suggestion">Feedback or suggestion</option>
							<option value="Other">Other</option>
						</select>
					</label>
					<label>
						<span>Message</span>
						<textarea name="message" rows="6" required></textarea>
					</label>
					<div class="contact-form__actions">
						<button class="button button--primary" type="submit">Prepare email</button>
						<a href={`mailto:${STUDIO_EMAIL}`}>Write directly</a>
					</div>
					<p id="contact-form-status" class="contact-form__status" aria-live="polite"></p>
				</form>
			</div>
			<p class="contact-page__note">
				For new releases and studio updates, follow Petalwake Studios on
				<a href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer">YouTube</a>.
			</p>
		</main>
		<SiteFooter />
	</body>
</html>

<script>
	const form = document.querySelector<HTMLFormElement>('#contact-form');
	const status = document.querySelector<HTMLElement>('#contact-form-status');

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		const formData = new FormData(form);
		const name = String(formData.get('name') ?? '').trim();
		const email = String(formData.get('email') ?? '').trim();
		const topic = String(formData.get('topic') ?? 'General inquiry').trim();
		const message = String(formData.get('message') ?? '').trim();
		const {
			requiredMessage,
			subjectPrefix,
			preparedMessage,
			nameLabel,
			emailLabel,
			topicLabel,
			messageLabel,
			emailAddress,
		} = form.dataset;

		if (!name || !email || !message) {
			if (!requiredMessage) {
				console.error('The localized contact form is missing its required-field message.');
				return;
			}
			if (status) {
				status.textContent = requiredMessage;
				status.dataset.state = 'error';
			}
			return;
		}

		if (!subjectPrefix || !nameLabel || !emailLabel || !topicLabel || !messageLabel || !emailAddress) {
			console.error('The localized contact form is missing email labels.');
			return;
		}

		const subject = encodeURIComponent(`${subjectPrefix}: ${topic}`);
		const body = encodeURIComponent(
			`${nameLabel}: ${name}\n${emailLabel}: ${email}\n${topicLabel}: ${topic}\n\n${messageLabel}:\n${message}`,
		);
		window.location.href = `mailto:${emailAddress}?subject=${subject}&body=${body}`;
		if (status && preparedMessage) {
			status.textContent = preparedMessage;
			status.dataset.state = 'success';
		}
	});
</script>
