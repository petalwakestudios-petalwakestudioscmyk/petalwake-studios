---
import BaseHead from '../../components/BaseHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { SITE_TITLE } from '../../consts';
import { common } from '../../i18n/common';
import { ja } from '../../i18n/ja';
import { localizedPath } from '../../i18n/routing';

export const prerender = false;
Astro.response.status = 404;
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			language="ja"
			title={`${ja.notFound.title} | ${SITE_TITLE}`}
			description={ja.notFound.description}
			robots="noindex, follow"
			includeHreflang={false}
		/>
	</head>
	<body class="not-found-page" lang="ja">
		<a class="skip-link" href="#main-content">{common.ja.skipToContent}</a>
		<SiteHeader />
		<main id="main-content" tabindex="-1">
			<p class="eyebrow">{ja.notFound.eyebrow}</p>
			<h1>{ja.notFound.heading}</h1>
			<p>{ja.notFound.body}</p>
			<nav aria-label="ページが見つからない場合のリンク">
				<a href={localizedPath('/', 'ja')}>{ja.notFound.home}</a>
				<a href={localizedPath('/work/', 'ja')}>{ja.notFound.films}</a>
			</nav>
		</main>
		<SiteFooter />
	</body>
</html>
