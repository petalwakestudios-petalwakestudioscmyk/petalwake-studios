---
import BaseHead from '../../components/BaseHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { YOUTUBE_CHANNEL } from '../../consts';
import { common } from '../../i18n/common';
import { ja } from '../../i18n/ja';
import { localizedPath } from '../../i18n/routing';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead language="ja" title={ja.metadata.aboutTitle} description={ja.metadata.aboutDescription} />
	</head>
	<body class="about-page" lang="ja">
		<a class="skip-link" href="#main-content">{common.ja.skipToContent}</a>
		<SiteHeader />
		<main id="main-content" tabindex="-1">
			<header class="about-page__intro" data-reveal>
				<p class="eyebrow">{ja.about.eyebrow}</p>
				<h1 set:html={ja.about.title} />
				<p class="about-page__lead">{ja.about.lead}</p>
				<p>{ja.about.intro}</p>
			</header>

			<section class="about-page__section about-page__section--light" aria-labelledby="foundation-title" data-reveal>
				<p class="eyebrow">{ja.about.beliefsEyebrow}</p>
				<div>
					<h2 id="foundation-title">{ja.about.creatorHeading}</h2>
					<p>{ja.about.creatorOne}</p>
					<p>{ja.about.creatorTwo}</p>
				</div>
			</section>

			<section class="about-page__section" aria-labelledby="grace-title" data-reveal>
				<p class="eyebrow">{ja.about.graceEyebrow}</p>
				<div>
					<h2 id="grace-title">{ja.about.graceHeading}</h2>
					<p>{ja.about.graceOne}</p>
					<p>{ja.about.graceTwo}</p>
					<p>{ja.about.graceThree}</p>
				</div>
			</section>

			<section class="about-page__section about-page__section--inspiration" aria-labelledby="approach-title" data-reveal>
				<p class="eyebrow">{ja.about.approachEyebrow}</p>
				<div>
					<h2 id="approach-title">{ja.about.approachHeading}</h2>
					<p>{ja.about.approachOne}</p>
					<p>{ja.about.approachTwo}</p>
				</div>
			</section>

			<section class="about-page__section about-page__section--light" aria-labelledby="scripture-title" data-reveal>
				<p class="eyebrow">{ja.about.scriptureEyebrow}</p>
				<div>
					<h2 id="scripture-title">{ja.about.scriptureHeading}</h2>
					<blockquote>
						<p>{ja.about.scriptureQuote}</p>
						<cite>{ja.about.scriptureCitation}</cite>
					</blockquote>
					<p>{ja.about.scriptureCopy}</p>
				</div>
			</section>

			<section class="about-page__section about-page__section--closing" aria-labelledby="looking-forward-title" data-reveal>
				<p class="eyebrow">{ja.about.futureEyebrow}</p>
				<div>
					<h2 id="looking-forward-title">{ja.about.futureHeading}</h2>
					<p>{ja.about.futureCopy}</p>
					<p><a href={localizedPath('/work/', 'ja')}>{ja.about.exploreFilms} <span aria-hidden="true">↗</span></a></p>
					<p><a href={localizedPath('/gospel/', 'ja')}>{ja.about.readGospel} <span aria-hidden="true">↗</span></a></p>
					<p><a href={YOUTUBE_CHANNEL} target="_blank" rel="noopener noreferrer">{ja.about.visitYouTube} <span aria-hidden="true">↗</span></a></p>
				</div>
			</section>
		</main>
		<SiteFooter />
	</body>
</html>
