---
import BaseHead from '../../components/BaseHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { common } from '../../i18n/common';
import { ja } from '../../i18n/ja';
import { localizedPath } from '../../i18n/routing';
import { ARTWORK, FEATURED_ARTWORK } from '../../data/artwork';
import { MANGA_PROJECTS } from '../../data/manga';
import IshiFeatureCard from '../../components/IshiFeatureCard.astro';

const t = ja.home;
const featuredManga = MANGA_PROJECTS[0];
const featuredScriptureCard = ARTWORK.find((item) => item.collection === 'Eternal Light');
if (!featuredManga || !featuredScriptureCard) throw new Error('Featured work data is incomplete.');
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			language="ja"
			title={ja.metadata.homeTitle}
			description={ja.metadata.homeDescription}
			imageAlt="夕暮れの山あいの湖に重なる、Petalwake Studiosのロゴ。"
		/>
	</head>
	<body class="home-page" lang="ja">
		<a class="skip-link" href="#main-content">{common.ja.skipToContent}</a>
		<SiteHeader />
		<main id="main-content" tabindex="-1">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero__art">
					<img
						src="/images/petalwake-hero-1536.webp"
						srcset="/images/petalwake-hero-640.webp 640w, /images/petalwake-hero-960.webp 960w, /images/petalwake-hero-1536.webp 1536w"
						sizes="100vw"
						alt={t.heroImageAlt}
						width="1536"
						height="1024"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
				<div class="hero__atmosphere" aria-hidden="true"></div>
				<div class="hero__content">
					<p class="eyebrow hero__overline" data-hero-enter>{t.heroOverline}</p>
					<h1 class="hero__title" id="hero-title" data-hero-enter>
						<span>Petalwake</span>
						<span>Studios</span>
					</h1>
					<p class="hero__descriptor" data-hero-enter>{t.tagline}</p>
					<a class="button button--primary" href={localizedPath('/work/', 'ja')} data-hero-enter>
						{t.exploreFilms} <span aria-hidden="true">↗</span>
					</a>
				</div>
				<a class="hero__scroll" href="#featured-work" aria-label={t.scrollAria}>
					<span aria-hidden="true"></span>
					{t.scrollLabel}
				</a>
			</section>

			<section class="work section-wrap" id="featured-work" aria-labelledby="work-title" data-reveal>
				<div class="section-heading">
					<p class="eyebrow">Petalwake Studios</p>
					<h2 id="work-title">注目作品</h2>
				</div>
				<article class="film-feature">
					<a
						class="film-feature__image"
						href={localizedPath('/work/the-last-winter/', 'ja')}
						aria-label={t.featuredImageAria}
					>
						<img
							src="/images/the-last-winter-thumbnail.webp"
							srcset="/images/the-last-winter-thumbnail-640.webp 640w, /images/the-last-winter-thumbnail.webp 1280w"
							sizes="(max-width: 760px) calc(100vw - 48px), 60vw"
							alt={ja.film.heroAlt}
							width="1280"
							height="720"
							loading="lazy"
							decoding="async"
						/>
						<span class="film-feature__play" aria-hidden="true">↗</span>
					</a>
					<div class="film-feature__info">
						<p class="eyebrow">FILM · {t.filmType}</p>
						<h3>The Last Winter</h3>
						<p class="film-feature__logline">{ja.film.shortDescription}</p>
						<div class="film-feature__links">
							<a href="/ja/films/">映像作品を見る <span aria-hidden="true">↗</span></a>
							<a href="https://www.youtube.com/watch?v=jdS6HNKDxRI" target="_blank" rel="noopener noreferrer">
								{t.watchFilm} <span aria-hidden="true">↗</span>
							</a>
							<a href={localizedPath('/work/the-last-winter/', 'ja')}>{t.enterStory} <span aria-hidden="true">↗</span></a>
						</div>
					</div>
				</article>
				<div class="work__medium-grid" aria-label="注目作品">
					<article class="work-medium work-medium--manga">
						<div class="work-medium__image manga-card__cover" data-cover-style={featuredManga.coverStyle}>
							<div class="manga-cover__scene" aria-hidden="true">
								<span class="manga-cover__shape manga-cover__shape--one"></span>
								<span class="manga-cover__shape manga-cover__shape--two"></span>
								<span class="manga-cover__shape manga-cover__shape--three"></span>
							</div>
							<p class="manga-cover__brand">Petalwake Studios <span>MANGA ・ 漫画</span></p>
							<span class="manga-cover__number">{featuredManga.number}</span>
							<p class="manga-cover__status">{ja.manga.comingSoon}</p>
						</div>
						<div class="work-medium__details">
							<p class="eyebrow">Manga</p>
							<h3 lang="ja">{featuredManga.titleJa}</h3>
							<a class="work-medium__link" href={localizedPath('/manga/', 'ja')}>漫画を見る <span aria-hidden="true">↗</span></a>
						</div>
					</article>
					<IshiFeatureCard language="ja" />
					<article class="work-medium work-medium--artwork">
						<a class="work-medium__image" href={localizedPath('/artwork/', 'ja')} aria-label="Eternal Lightの聖書カードを見る">
							<img src={featuredScriptureCard.thumbnail} srcset={`${featuredScriptureCard.thumbnail} 640w, ${featuredScriptureCard.mediumThumbnail} 768w, ${featuredScriptureCard.image} 1024w`} sizes="(max-width: 700px) calc(100vw - 48px), 42vw" alt={featuredScriptureCard.alt} width="1024" height="1536" loading="lazy" decoding="async" />
						</a>
						<div class="work-medium__details">
							<p class="eyebrow">Artwork</p>
							<h3>Eternal Light</h3>
							<a class="work-medium__link" href={localizedPath('/artwork/', 'ja')}>アートワークを見る <span aria-hidden="true">↗</span></a>
						</div>
					</article>
				</div>
			</section>

			<section class="home-artwork section-wrap" aria-labelledby="home-artwork-title" data-reveal>
				<div class="section-heading">
					<div>
						<p class="eyebrow">{t.artworkEyebrow}</p>
						<h2 id="home-artwork-title">{t.artworkHeading}</h2>
					</div>
					<a class="text-link" href={localizedPath('/artwork/', 'ja')}>{t.artworkLink} <span aria-hidden="true">↗</span></a>
				</div>
				<p class="home-artwork__intro">{t.artworkCopy}</p>
				<div class="home-artwork__grid">
					{FEATURED_ARTWORK.map((item) => (
						<a class="home-artwork__card" href={localizedPath('/artwork/', 'ja')}>
							<img src={item.thumbnail} srcset={`${item.thumbnail} 640w, ${item.mediumThumbnail} 768w, ${item.image} 1024w`} sizes="(min-width: 1000px) 28vw, (min-width: 601px) 42vw, calc(100vw - 48px)" alt={item.alt} width="1024" height="1536" loading="lazy" decoding="async" />
							<span>{item.collection}</span>
							<strong>{item.title}</strong>
						</a>
					))}
				</div>
			</section>

			<section class="creative-portfolio section-wrap" aria-labelledby="creative-portfolio-title" data-reveal>
				<div class="creative-portfolio__heading">
					<p class="eyebrow">{t.creativeEyebrow}</p>
					<h2 id="creative-portfolio-title" set:html={t.creativeHeading} />
					<p>{t.creativeCopy}</p>
				</div>
				<div class="creative-portfolio__forms" aria-label={t.creativeFormsAria}>
					{t.creativeForms.map((form, index) => (
						<div><span>{String(index + 1).padStart(2, '0')}</span><h3>{form}</h3></div>
					))}
				</div>
				<p class="creative-portfolio__note">{t.creativeNote}</p>
			</section>

			<section class="studio-intro section-wrap" aria-labelledby="studio-intro-title" data-reveal>
				<p class="eyebrow">{t.studioEyebrow}</p>
				<div class="studio-intro__content">
					<h2 id="studio-intro-title" set:html={t.studioHeading} />
					<p class="studio-intro__lead">{t.studioLead}</p>
					<p>{t.studioCopy}</p>
					<a class="text-link" href={localizedPath('/about/', 'ja')}>{t.meetStudio} <span aria-hidden="true">↗</span></a>
				</div>
			</section>

			<section class="home-purpose section-wrap" aria-labelledby="home-purpose-title" data-reveal>
				<p class="eyebrow">{t.faithEyebrow}</p>
				<div>
					<h2 id="home-purpose-title" set:html={t.faithHeading} />
					<p>{t.faithCopy}</p>
					<div class="home-purpose__links">
						<a href={localizedPath('/gospel/', 'ja')}>{t.readGospel} <span aria-hidden="true">↗</span></a>
						<a href={localizedPath('/contact/', 'ja')}>{t.getInTouch} <span aria-hidden="true">↗</span></a>
					</div>
				</div>
			</section>
		</main>
		<SiteFooter />
	</body>
</html>
