---
import BaseHead from '../../components/BaseHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { TURNSTILE_SITE_KEY } from '../../consts';
import { common } from '../../i18n/common';
import { ja } from '../../i18n/ja';
import { localizedPath } from '../../i18n/routing';
import { CONTACT_TOPICS } from '../../lib/contact-contract';
import { contactTopicLabels } from '../../i18n/contact-topics';
import SocialLinks from '../../components/SocialLinks.astro';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead language="ja" title={ja.metadata.contactTitle} description={ja.metadata.contactDescription} />
	</head>
	<body class="contact-page" lang="ja">
		<a class="skip-link" href="#main-content">{common.ja.skipToContent}</a>
		<SiteHeader />
		<main id="main-content" tabindex="-1" data-reveal>
			<p class="eyebrow">{ja.contact.eyebrow}</p>
			<h1>{ja.contact.title}</h1>
			<p>
				{ja.contact.intro}
			</p>
			<div class="contact-card">
				<p class="contact-form__note">
					{ja.contact.formNote}
				</p>
				<noscript>
					<p class="contact-form__note">
						{ja.contact.noscript}
					</p>
				</noscript>
				<form
					id="contact-form"
					class="contact-form"
					method="post"
					action="/api/contact"
					novalidate
					data-turnstile-site-key={TURNSTILE_SITE_KEY}
					data-locale="ja"
				>
					<div class="contact-form__row">
						<label>
							<span>{ja.contact.name}</span>
							<input type="text" name="name" autocomplete="name" required maxlength="120" />
						</label>
						<label>
							<span>{ja.contact.email}</span>
							<input type="email" name="email" autocomplete="email" required maxlength="254" />
						</label>
					</div>
					<label>
						<span>{ja.contact.topic}</span>
						<select name="topic" required>
							<option value="">{ja.contact.selectTopic}</option>
							{CONTACT_TOPICS.map((topic) => <option value={topic}>{contactTopicLabels.ja[topic]}</option>)}
						</select>
					</label>
					<label>
						<span>{ja.contact.message}</span>
						<textarea name="message" rows="6" required maxlength="2500"></textarea>
					</label>
					<div class="contact-form__honeypot" aria-hidden="true">
						<label for="contact-website">{ja.contact.honeypot}</label>
						<input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
					</div>
					<div class="contact-form__turnstile">
						<div id="contact-turnstile" aria-live="polite"></div>
						{TURNSTILE_SITE_KEY ? null : <p class="contact-form__note">{ja.contact.turnstileNotConfigured}</p>}
						<button class="contact-form__retry" type="button" data-turnstile-retry hidden>
							{ja.contact.retryTurnstile}
						</button>
					</div>
					<p class="contact-form__privacy">
						{ja.contact.privacyIntro}
						<a href={localizedPath('/privacy/', 'ja')}>{ja.contact.privacyLink}</a>
						{ja.contact.privacyTail}
					</p>
					<div class="contact-form__actions">
						<button class="button button--primary" type="submit">{ja.contact.send}</button>
					</div>
					<p id="contact-form-status" class="contact-form__status" aria-live="polite"></p>
				</form>
			</div>
			<p class="contact-page__note">
				新作やスタジオの近況は、InstagramやYouTubeでご覧いただけます。
			</p>
			<SocialLinks class="contact-page__social" label="SNS" />
		</main>
		<SiteFooter />
	</body>
</html>

<script src="../../scripts/contact-form.ts"></script>
