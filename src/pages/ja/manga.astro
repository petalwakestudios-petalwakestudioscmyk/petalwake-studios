---
import BaseHead from '../../components/BaseHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MangaExperience from '../../components/MangaExperience.astro';
import { common } from '../../i18n/common';
import { ja } from '../../i18n/ja';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead
			language="ja"
			title={ja.metadata.mangaTitle}
			description={ja.metadata.mangaDescription}
		/>
	</head>
	<body class="manga-page-body" lang="ja">
		<a class="skip-link" href="#main-content">{common.ja.skipToContent}</a>
		<SiteHeader />
		<MangaExperience locale="ja" copy={ja.manga} />
		<SiteFooter />
	</body>
</html>
