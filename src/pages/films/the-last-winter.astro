---
import BaseHead from '../../components/BaseHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { FILMS, SITE_TITLE } from '../../consts';

const film = FILMS[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${film.title} | ${SITE_TITLE}`}
			description={`${film.title} - ${film.kind} from ${SITE_TITLE}.`}
			image={film.thumbnail}
		/>
	</head>
	<body class="film-page">
		<SiteHeader />
		<main>
			<section class="film-page__intro" aria-labelledby="film-title">
				<a class="film-page__back" href="/#work">← Back to our work</a>
				<p class="eyebrow">{film.kind} <span>·</span> {film.year}</p>
				<h1 id="film-title">{film.title}</h1>
				<p>A short animated film by Petalwake Studios.</p>
			</section>
			<div class="film-page__player">
				<iframe
					src={`https://www.youtube-nocookie.com/embed/${film.youtubeId}`}
					title={`Watch ${film.title} on YouTube`}
					loading="lazy"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					referrerpolicy="strict-origin-when-cross-origin"
					allowfullscreen
				></iframe>
			</div>
			<p class="film-page__channel">
				<a href={film.youtubeUrl} target="_blank" rel="noopener noreferrer">
					Watch on YouTube <span aria-hidden="true">↗</span>
				</a>
			</p>
		</main>
		<SiteFooter />
	</body>
</html>