---
import BaseHead from '../../../components/BaseHead.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import IshiProject from '../../../components/IshiProject.astro';
import { getIshiLanguage, ishiCover, ISHI_PATH } from '../../../data/ishi';

const language = getIshiLanguage(Astro.url.searchParams.get('lang'));
const title = language === 'ja'
	? '『ISHI 石』プロローグ01「静寂」| Petalwake Studios'
	: 'ISHI: Prologue 01, Silence | Petalwake Studios';
const description = language === 'ja'
	? '孤独さえ異常と見なされる都市で、レンは自分にだけ反応する一つの石を見つける。オリジナルマンガを日本語または英語で読む。'
	: 'In a city where solitude has become an abnormality, Ren discovers a forgotten stone that responds only to him. Read the original manga in English or Japanese.';
const alternates = {
	en: new URL(`${ISHI_PATH}?lang=en`, Astro.site).href,
	ja: new URL(`${ISHI_PATH}?lang=ja`, Astro.site).href,
};
---

<!doctype html>
<html lang={language}>
	<head>
		<BaseHead
			language={language}
			title={title}
			description={description}
			image={ishiCover(language)}
			imageAlt={language === 'ja' ? '『ISHI 石』プロローグ01「静寂」表紙' : 'ISHI: Prologue 01, Silence manga cover'}
			imageWidth={720}
			imageHeight={1080}
			canonical={ISHI_PATH}
			includeHreflang={false}
		/>
		<link rel="alternate" hreflang="en" href={alternates.en} />
		<link rel="alternate" hreflang="ja" href={alternates.ja} />
		<link rel="alternate" hreflang="x-default" href={alternates.en} />
	</head>
	<body class="ishi-project-page" lang={language}>
		<a class="skip-link" href="#main-content">{language === 'ja' ? '本文へ移動' : 'Skip to content'}</a>
		<SiteHeader />
		<IshiProject language={language} />
		<SiteFooter />
	</body>
</html>
