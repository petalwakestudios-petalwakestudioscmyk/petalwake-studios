---
import BaseHead from '../../../components/BaseHead.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import IshiProject from '../../../components/IshiProject.astro';
import { getIshiLanguage, ISHI_PATH } from '../../../data/ishi';

const language = getIshiLanguage(Astro.url.searchParams.get('lang'));
const title = language === 'ja'
	? '『ISHI 石』プロローグ01「静寂」| Petalwake Studios'
	: 'ISHI: Prologue 01, Silence | Petalwake Studios';
const description = language === 'ja'
	? '孤独、つながり、そして、ただ一人に反応する石をめぐる静かなSFマンガ。英語版・日本語版を公開中。'
	: 'Read ISHI, a quiet science-fiction manga about isolation, connection, and a forgotten stone that responds to one person alone. Available in English and Japanese.';
const alternates = {
	en: new URL(`${ISHI_PATH}?lang=en`, Astro.site).href,
	ja: new URL(`${ISHI_PATH}?lang=ja`, Astro.site).href,
};
---

<!doctype html>
<html lang={language}>
	<head>
		<BaseHead
			language={language}
			title={title}
			description={description}
			image="/images/releases/ishi/ishi-bilingual-release.png"
			imageAlt={language === 'ja' ? '『ISHI 石』プロローグ01「静寂」英語版・日本語版のリリースアート。都市の夜景と、物語を象徴する石。' : 'Bilingual ISHI: Prologue 01, Silence release artwork, showing a city at night and the stone at the heart of the story.'}
			imageWidth={1254}
			imageHeight={1254}
			canonical={ISHI_PATH}
			includeHreflang={false}
		/>
		<link rel="alternate" hreflang="en" href={alternates.en} />
		<link rel="alternate" hreflang="ja" href={alternates.ja} />
		<link rel="alternate" hreflang="x-default" href={alternates.en} />
	</head>
	<body class="ishi-project-page" lang={language}>
		<a class="skip-link" href="#main-content">{language === 'ja' ? '本文へ移動' : 'Skip to content'}</a>
		<SiteHeader />
		<IshiProject language={language} />
		<SiteFooter />
	</body>
</html>
