# Public frontend config
PUBLIC_TURNSTILE_SITE_KEY=

# Configure these as encrypted Worker secrets in Cloudflare.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=

# Public contact-form behavior. The production Worker hostname allowlist is
# enforced in code; do not add localhost to production.
ENVIRONMENT=development
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1,petalwakestudios.com,www.petalwakestudios.com
RESEND_FROM_EMAIL=noreply@petalwakestudios.com
